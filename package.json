{
  "name": "rpa-studio",
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "package": "npm run build && electron-builder",
    "package:win": "node scripts/build-unified-installer.mjs",
    "package:win:studio": "npm run build && electron-builder --win --arm64",
    "package:win:robot": "npm.cmd --prefix Robot run package:win"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.5",
    "pdfjs-dist": "^6.2.108",
    "playwright-core": "^1.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "tesseract.js": "^7.0.0",
    "uuid": "^9.0.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5",
    "vite": "^5.3.4",
    "vite-plugin-electron": "^0.28.8"
  },
  "build": {
    "appId": "com.rpa.studio",
    "productName": "Runway Studio",
    "copyright": "Copyright © 2026 Runway Studio",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/@napi-rs/canvas-win32-arm64-msvc/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "optionalDependencies": {
    "@napi-rs/canvas-win32-arm64-msvc": "^1.0.5"
  }
}
